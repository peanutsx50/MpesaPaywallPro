{
  "name": "festusmurimi/mpesapaywallpro",
  "description": "MpesaPaywallPro is a WordPress plugin that integrates M-Pesa payment gateway and restricts your premium content behind a paywall allowing you to monetize your website effectively.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "MpesaPaywallPro\\": "includes/",
      "MpesaPaywallPro\\admin\\": "admin/",
      "MpesaPaywallPro\\public\\": "public/",
      "PluginTests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-install": "bash bin/install-wp-tests.sh wordpress_test wp_test 'password' 127.0.0.1 latest",
    "analyze": "vendor/bin/phpstan analyse"
  },
  "authors": [
    {
      "name": "Surge Technologies",
      "email": "admin@surgetech.co.ke"
    }
  ],
  "require": {
    "php": ">=7.4",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.7",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-phpunit/wp-phpunit": "^6.3",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
