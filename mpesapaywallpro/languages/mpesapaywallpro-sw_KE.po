msgstr "Nambari ya simu ya kutumia kufanya jaribio la API (katika mfumo wa kimataifa, k.m. 254...)"

#: admin/partials/mpesa-setup.php:185
msgid "Test Connection"
msgstr "Jaribu Muunganisho"

#: admin/partials/mpesa-setup.php:187
