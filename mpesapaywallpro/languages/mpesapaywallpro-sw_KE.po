#: admin/partials/mpesa-setup.php:65
msgid "Your M-Pesa Daraja API Consumer Secret"
msgstr "Consumer Secret yako ya M-Pesa Daraja API"

#: admin/partials/mpesa-setup.php:73
msgid "Business Shortcode"
msgstr "Nambari ya Kampuni (Shortcode)"

#: admin/partials/mpesa-setup.php:83
msgid "Your M-Pesa Business Shortcode (PayBill or Till Number)"
msgstr "Nambari ya Kampuni yako (PayBill au Till Number)"

#: admin/partials/mpesa-setup.php:91
