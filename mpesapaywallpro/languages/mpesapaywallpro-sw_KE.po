msgstr "Maelezo ya Muamala"

#: admin/partials/mpesa-setup.php:137
msgid "A brief description of the transaction e.g., Payment for article access"
msgstr "Maelezo mafupi ya muamala, k.m., Malipo ya kusoma makala"

#: admin/partials/mpesa-setup.php:145
msgid "Environment"
msgstr "Mazingira"

#: admin/partials/mpesa-setup.php:150
msgid "Sandbox (Testing)"
msgstr "Sandbox (Majaribio)"

#: admin/partials/mpesa-setup.php:153
msgid "Production (Live)"
msgstr "Production (Halisi)"

#: admin/partials/mpesa-setup.php:157
msgid "If you are using test credentials, select Sandbox. For live transactions, select Production."
msgstr "Ikiwa unatumia maelezo ya jaribio, chagua Sandbox. Kwa miamala halisi, chagua Production."

#: admin/partials/mpesa-setup.php:165
msgid "Test Phone Number"
msgstr "Nambari ya Simu ya Jaribio"

#: admin/partials/mpesa-setup.php:175
