msgstr "Usanidi wa M-Pesa API"

#: admin/partials/mpesa-setup.php:27
msgid "Enter your M-Pesa Daraja API credentials. These are required to process payments through Safaricom."
msgstr "Ingiza maelezo yako ya M-Pesa Daraja API. Haya yanahitajika ili kushughulikia malipo kupitia Safaricom."

#: admin/partials/mpesa-setup.php:28
msgid "Get API credentials"
msgstr "Pata maelezo ya API"

