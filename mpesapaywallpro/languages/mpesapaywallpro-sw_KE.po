#. Plugin Name of the plugin
#: MpesaPaywallPro.php
msgid "MpesaPaywallPro"
msgstr "MpesaPaywallPro"

#. Plugin URI of the plugin
#: MpesaPaywallPro.php
msgid "https://surgetech.co.ke/mpesapaywallpro"
msgstr "https://surgetech.co.ke/mpesapaywallpro"

#. Description of the plugin
#: MpesaPaywallPro.php
msgid "MpesaPaywallPro is a WordPress plugin that integrates M-Pesa payment gateway and restricts your premium content behind a paywall allowing you to monetize your website effectively."
msgstr "MpesaPaywallPro ni programu-jalizi ya WordPress inayounganisha malipo ya M-Pesa na kuzuia maudhui yako maalum hadi yalipewe, kukuwezesha kupata mapato kupitia tovuti yako."

#. Author of the plugin
#: MpesaPaywallPro.php
msgid "SurgeTech"
msgstr "SurgeTech"

#. Author URI of the plugin
#: MpesaPaywallPro.php
msgid "https://surgetech.co.ke/"
msgstr "https://surgetech.co.ke/"

#: admin/MpesaPaywallProAdmin.php:168
msgid "Warning: Your site is not using SSL. For secure M-Pesa transactions, please enable HTTPS on your website."
msgstr "Onyo: Tovuti yako haitumii SSL. Kwa miamala salama ya M-Pesa, tafadhali wezesha HTTPS kwenye tovuti yako."

#: admin/MpesaPaywallProAdmin.php:203
msgid "MpesaPaywall"
msgstr "MpesaPaywall"

#: admin/partials/access-control.php:22
msgid "Access Control & Security"
msgstr "Udhibiti wa Ufikiaji na Usalama"

#: admin/partials/access-control.php:27
msgid "Configure security settings and access controls for your paywall system."
msgstr "Sanidi mipangilio ya usalama na udhibiti wa ufikiaji wa mfumo wako wa malipo (paywall)."

#: admin/partials/access-control.php:35
msgid "Exempt User Roles"
msgstr "Majukumu ya Watumiaji Yasiyozuiliwa"

#: admin/partials/access-control.php:54
msgid "Selected user roles will bypass the paywall without payment"
msgstr "Majukumu ya watumiaji yaliyochaguliwa yataona maudhui bila kuhitajika kulipa"

#: admin/partials/access-control.php:64
msgid "Security Tips"
msgstr "Vidokezo vya Usalama"

#: admin/partials/access-control.php:67
msgid "Always use SSL/HTTPS for your website when processing payments"
msgstr "Tumia SSL/HTTPS kila wakati kwenye tovuti yako unapopokea malipo"

#: admin/partials/access-control.php:68
msgid "Keep your M-Pesa API credentials secure and never share them"
msgstr "Weka siri maelezo yako ya M-Pesa API na usimpe mtu yeyote"

#: admin/partials/access-control.php:69
msgid "Regularly update WordPress and the MpesaPaywallPro plugin"
msgstr "Sasisha WordPress na programu-jalizi ya MpesaPaywallPro mara kwa mara"

#: admin/partials/access-control.php:70
msgid "Monitor transaction logs for suspicious activity"
msgstr "Kagua kumbukumbu za miamala kwa shughuli zozote za kutiliwa shaka"

#: admin/partials/access-control.php:71
msgid "Use IP whitelisting for internal testing only"
msgstr "Tumia 'IP whitelisting' kwa majaribio ya ndani pekee"

#: admin/partials/admin-settings.php:53
msgid "Turn your WordPress content into revenue. Accept M-Pesa payments, control access to premium posts, and build a sustainable income stream."
msgstr "Badilisha maudhui yako ya WordPress kuwa mapato. Pokea malipo ya M-Pesa, dhibiti ufikiaji wa makala maalum, na ujitengenezee chanzo cha mapato."

#: admin/partials/admin-settings.php:61
msgid "Contact us for custom plugin"
msgstr "Wasiliana nasi kwa programu-jalizi maalum"

#: admin/partials/admin-settings.php:67
msgid "Read how to use this plugin"
msgstr "Soma jinsi ya kutumia programu-jalizi hii"

#: admin/partials/admin-settings.php:93
msgid "Welcome to MpesaPaywallPro"
msgstr "Karibu MpesaPaywallPro"

#: admin/partials/admin-settings.php:97
msgid "MpesaPaywallPro allows you to restrict access to content and require users to complete an M-Pesa payment before viewing it. To get started, enter your M-Pesa API credentials and configure the payment settings below."
msgstr "MpesaPaywallPro inakuwezesha kuzuia ufikiaji wa maudhui na kuhitaji watumiaji kukamilisha malipo ya M-Pesa kabla ya kuyaona. Ili kuanza, ingiza maelezo yako ya M-Pesa API na usanidi mipangilio ya malipo hapa chini."

#: admin/partials/admin-settings.php:104
msgid "You can use either Sandbox (Test) credentials or Live (Production) credentials. If you are testing, select the Sandbox environment and use your test credentials. If you are accepting real payments, select the Production environment and use your live credentials."
msgstr "Unaweza kutumia maelezo ya Sandbox (Jaribio) au maelezo ya Live (Uzalishaji). Ikiwa unafanya majaribio, chagua Sandbox. Ikiwa unakubali malipo halisi, chagua Production."

#: admin/partials/admin-settings.php:111
msgid "After entering your credentials, always click “Save Changes” first. Only test the API connection after your settings have been saved."
msgstr "Baada ya kuingiza maelezo yako, bonyeza “Save Changes” kwanza. Jaribu muunganisho wa API tu baada ya kuhifadhi mipangilio yako."

#: admin/partials/admin-settings.php:118
msgid "Enter your M-Pesa Consumer Key, Consumer Secret, Shortcode, and Passkey"
msgstr "Ingiza Consumer Key, Consumer Secret, Nambari ya Kampuni (Shortcode), na Passkey ya M-Pesa"

#: admin/partials/admin-settings.php:119
msgid "Select the correct environment: Sandbox for testing, Production for live payments"
msgstr "Chagua mazingira sahihi: Sandbox kwa majaribio, Production kwa malipo halisi"

#: admin/partials/admin-settings.php:120
msgid "Save your settings before testing the API connection"
msgstr "Hifadhi mipangilio yako kabla ya kujaribu muunganisho wa API"

#: admin/partials/admin-settings.php:121
msgid "Configure payment amounts and access duration after payment"
msgstr "Sanidi kiasi cha malipo na muda wa ufikiaji baada ya kulipa"

#: admin/partials/admin-settings.php:122
msgid "Control how locked content previews are displayed to users"
msgstr "Dhibiti jinsi onyesho la kwanza la maudhui yaliyofungwa linavyoonekana"

#: admin/partials/admin-settings.php:126
msgid "WARNING: Never share your M-Pesa API credentials with third parties, contractors, or employees. Anyone with access to these details can initiate payments on your behalf."
msgstr "ONYO: Usishiriki kamwe maelezo yako ya M-Pesa API na watu wengine, wakandarasi, au wafanyakazi. Mtu yeyote aliye na maelezo haya anaweza kuanzisha malipo kwa niaba yako."

#: admin/partials/content-locked-meta-box.php:39
msgid "Lock this post behind a paywall"
msgstr "Funga makala haya kwa malipo (paywall)"

#: admin/partials/content-locked-meta-box.php:45
msgid "Price (KES)"
msgstr "Bei (KES)"

